import 'package:flutter/material.dart';
import 'package:flutter/services.dart';

class CodeSnippetCard extends StatefulWidget {
  const CodeSnippetCard({super.key, required this.textString, this.language});

  final String textString;
  final String? language;
  @override
  State<CodeSnippetCard> createState() => _CodeSnippetCardState();
}

class _CodeSnippetCardState extends State<CodeSnippetCard> {
  bool showClipboard = false;
  @override
  Widget build(BuildContext context) {
    void showSnackBar() {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text("Snippet copied to Clipboard"),
          elevation: 3,
          behavior: SnackBarBehavior.floating,
        ),
      );
    }

    return TapRegion(
      onTapOutside: (event) => showClipboard
          ? setState(() {
              showClipboard = false;
            })
          : null,
      onTapInside: (event) => !showClipboard
          ? setState(() {
              showClipboard = true;
            })
          : null,
      onTapUpInside: (event) => !showClipboard
          ? setState(() {
              showClipboard = true;
            })
          : null,

      child: MouseRegion(
        onEnter: (event) => setState(() {
          showClipboard = true;
        }),
        onExit: (event) => setState(() {
          showClipboard = false;
        }),
        child: Stack(
          fit: StackFit.passthrough,
          children: [
            Card.outlined(
              margin: const EdgeInsets.symmetric(vertical: 12),
              elevation: 2,
              // color: const Color.fromARGB(255, 24, 24, 24),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Padding(
                    padding: const EdgeInsets.symmetric(
                      vertical: 8.0,
                      horizontal: 12,
                    ),
                    child: Text(
                      widget.language ?? "glsl",
                      style: const TextStyle(color: Colors.blueGrey),
                    ),
                  ),
                  Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Expanded(
                        child: SingleChildScrollView(
                          scrollDirection: Axis.horizontal,
                          child: Padding(
                            padding: const EdgeInsets.only(
                              left: 20.0,
                              right: 20,
                              top: 4,
                              bottom: 16,
                            ),
                            child: Column(
                              mainAxisAlignment: MainAxisAlignment.start,
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: widget.textString
                                  .split("\n")
                                  .map(
                                    (String line) => Text.rich(
                                      TextSpan(
                                        text: "",
                                        children:
                                            widget.language == 'glsl' ||
                                                widget.language == null
                                            ? line
                                                  .split("//")
                                                  .indexed
                                                  .map(
                                                    ((
                                                      commentDelimitedLine,
                                                    ) => commentDelimitedLine.$2
                                                        .split(" ")
                                                        .map(
                                                          (String word) =>
                                                              line.contains(
                                                                    "// ",
                                                                  ) &&
                                                                  commentDelimitedLine
                                                                          .$1 ==
                                                                      1
                                                              ? TextSpan(
                                                                  text:
                                                                      "$word ",
                                                                  style: const TextStyle(
                                                                    color: Colors
                                                                        .grey,
                                                                  ),
                                                                )
                                                              : word.contains(
                                                                  '(',
                                                                )
                                                              ? word
                                                                    .split('(')
                                                                    .indexed
                                                                    .map(
                                                                      (
                                                                        bracketDelimitedWord,
                                                                      ) =>
                                                                          bracketDelimitedWord
                                                                              .$1
                                                                              .isEven
                                                                          ? TextSpan(
                                                                              text: bracketDelimitedWord.$2,
                                                                              style: const TextStyle(
                                                                                color: Colors.greenAccent,
                                                                              ),
                                                                            )
                                                                          : TextSpan(
                                                                              text: '(${bracketDelimitedWord.$2} ',
                                                                            ),
                                                                    )
                                                                    .fold(
                                                                      const TextSpan(
                                                                        text:
                                                                            "",
                                                                      ),
                                                                      (
                                                                        previousValue,
                                                                        element,
                                                                      ) => TextSpan(
                                                                        children: [
                                                                          previousValue,
                                                                          element,
                                                                        ],
                                                                      ),
                                                                    )
                                                              : word.contains(
                                                                  ".",
                                                                )
                                                              ? word
                                                                    .split('.')
                                                                    .indexed
                                                                    .map(
                                                                      (
                                                                        nestedVariableWord,
                                                                      ) =>
                                                                          nestedVariableWord.$1 !=
                                                                              word.split('.').length -
                                                                                  1
                                                                          ? TextSpan(
                                                                              text: "${nestedVariableWord.$2}.",
                                                                              style: TextStyle(
                                                                                color:
                                                                                    RegExp(
                                                                                      r'^[a-zA-Z_]+$',
                                                                                    ).hasMatch(
                                                                                      nestedVariableWord.$2,
                                                                                    )
                                                                                    ? Colors.orangeAccent
                                                                                    : null,
                                                                              ),
                                                                            )
                                                                          : TextSpan(
                                                                              text: "${nestedVariableWord.$2} ",
                                                                            ),
                                                                    )
                                                                    .fold(
                                                                      const TextSpan(
                                                                        text:
                                                                            "",
                                                                      ),
                                                                      (
                                                                        previousValue,
                                                                        element,
                                                                      ) => TextSpan(
                                                                        children: [
                                                                          previousValue,

                                                                          element,
                                                                        ],
                                                                      ),
                                                                    )
                                                              : TextSpan(
                                                                  text:
                                                                      "$word ",
                                                                  style: TextStyle(
                                                                    color:
                                                                        word ==
                                                                                "#define" ||
                                                                            word ==
                                                                                "#expand" ||
                                                                            word ==
                                                                                "#include" ||
                                                                            word ==
                                                                                ("int") ||
                                                                            word ==
                                                                                ("float") ||
                                                                            word ==
                                                                                ("double") ||
                                                                            word ==
                                                                                ("bool") ||
                                                                            word ==
                                                                                "void" ||
                                                                            word ==
                                                                                "vec4" ||
                                                                            word ==
                                                                                "vec3" ||
                                                                            word ==
                                                                                "vec2" ||
                                                                            word ==
                                                                                "mat3"
                                                                        ? Colors
                                                                              .redAccent
                                                                        : word.contains(
                                                                            "float(",
                                                                          )
                                                                        ? Colors
                                                                              .grey
                                                                        : null,
                                                                  ),
                                                                ),
                                                        )
                                                        .toList()
                                                        .fold(
                                                          TextSpan(
                                                            text:
                                                                line.contains(
                                                                      "//",
                                                                    ) &&
                                                                    commentDelimitedLine
                                                                            .$1 ==
                                                                        1
                                                                ? "//"
                                                                : "",
                                                            style:
                                                                const TextStyle(
                                                                  color: Colors
                                                                      .grey,
                                                                ),
                                                          ),
                                                          (
                                                            previousValue,
                                                            element,
                                                          ) => TextSpan(
                                                            children: [
                                                              previousValue,
                                                              element,
                                                            ],
                                                          ),
                                                        )),
                                                  )
                                                  .toList()
                                            : line
                                                  .split(' ')
                                                  .map(
                                                    (String word) => TextSpan(
                                                      text: '$word ',
                                                    ),
                                                  )
                                                  .toList(),
                                      ),
                                    ),
                                  )
                                  .toList(),
                            ),
                          ),
                        ),
                      ),
                    ],
                  ),
                ],
              ),
            ),
            showClipboard
                ? Align(
                    alignment: Alignment.topRight,
                    child: Padding(
                      padding: const EdgeInsets.only(right: 12, top: 16),
                      child: IconButton(
                        visualDensity: VisualDensity.compact,
                        onPressed: () async {
                          await Clipboard.setData(
                            ClipboardData(text: widget.textString),
                          ).then((_) => showSnackBar());
                        },
                        iconSize: 20,
                        icon: const Icon(Icons.copy),
                      ),
                    ),
                  )
                : const SizedBox(),
          ],
        ),
      ),
    );
  }
}
